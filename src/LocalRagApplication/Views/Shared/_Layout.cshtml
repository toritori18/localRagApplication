<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ローカルRAG検索</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="container body-content">
        <header class="py-2 mb-3 border-bottom">
            <span class="h5 mb-0">@Html.ActionLink("ローカルRAG検索", "Index", "Home", new { area = "" }, null)</span>
        </header>
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - ローカルRAG検索</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @* _ConfirmModal.cshtml 内のスクリプトが jQuery と bootstrap.Modal に依存するため、
       両バンドルの読み込みより後にレンダリングする必要がある *@
    @Html.Partial("_ConfirmModal")
    @RenderSection("scripts", required: false)
</body>
</html>
