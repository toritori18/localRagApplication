<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ローカルRAG検索</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="container body-content">
        <nav class="py-2 mb-3 border-bottom small" aria-label="メインナビゲーション">
            @Html.ActionLink("ホーム", "Index", "Home", new { area = "" }, null)
            <span class="text-muted">|</span>
            @Html.ActionLink("ドキュメント", "Index", "Documents", new { area = "" }, null)
            <span class="text-muted">|</span>
            @Html.ActionLink("質問", "Index", "Ask", new { area = "" }, null)
        </nav>
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - ローカルRAG検索</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
