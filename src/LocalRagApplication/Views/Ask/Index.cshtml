@model LocalRagApplication.Models.AskViewModel
@{
    ViewBag.Title = "質問";
    var message = ViewBag.Message as string;
    var history = Model != null ? Model.History : null;
    var hasHistory = history != null && history.Count > 0;
}

@Html.Partial("_BackToHome")

<h1>質問</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-warning">@message</div>
}

<div class="mb-4">
    @if (hasHistory)
    {
        foreach (var turn in history)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-end mb-2">
                    <div class="card text-bg-primary" style="max-width: 75%;">
                        <div class="card-body py-2 px-3">
                            <div class="small">
                                <strong>あなた</strong>
                                <span class="opacity-75">@turn.AskedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <div style="white-space: pre-wrap;">@turn.Question</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-start mb-2">
                    <div class="card bg-light" style="max-width: 75%;">
                        <div class="card-body py-2 px-3">
                            <div class="small text-muted">
                                <strong>AI</strong>
                                @turn.AskedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </div>
                            <div style="white-space: pre-wrap;">@turn.Answer</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">まだ質問がありません。</p>
    }
</div>

<form id="askForm" action="@Url.Action("Index")" method="post" class="mb-2">
    @Html.AntiForgeryToken()
    <div class="form-group mb-2">
        <label for="question">質問内容</label>
        <textarea id="question" name="question" rows="3" class="form-control" style="max-width: 560px;" placeholder="質問を入力してください">@(Model != null ? Model.Question : null)</textarea>
    </div>
    <button id="askButton" type="submit" class="btn btn-primary">質問する</button>
</form>

@if (hasHistory)
{
    <form action="@Url.Action("Clear")" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary btn-sm" data-confirm-message="会話履歴をクリアしますか？">履歴をクリア</button>
    </form>
}

@section scripts {
    <script>
        $(function () {
            $('#askForm').on('submit', function () {
                $('#askButton').prop('disabled', true).text('回答を生成中...');
            });
        });
    </script>
}
