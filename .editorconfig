# エディタ間でインデント・文字コード・改行を統一する
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Markdown は行末スペース 2 個が改行の意味を持つため削除しない
trim_trailing_whitespace = false

# PowerShell 5.1 は BOM なしだと日本語を ANSI として誤読するため、BOM 必須・CRLF
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

# C# コーディング規則（出典: https://learn.microsoft.com/ja-jp/dotnet/fundamentals/code-analysis/style-rules/naming-rules）
[*.cs]
indent_size = 4

# private フィールドは _camelCase
dotnet_naming_rule.private_fields_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# 型・メソッド・プロパティ・イベントは PascalCase
dotnet_naming_rule.types_members_pascal_case.severity = warning
dotnet_naming_rule.types_members_pascal_case.symbols = types_members
dotnet_naming_rule.types_members_pascal_case.style = pascal_case

dotnet_naming_symbols.types_members.applicable_kinds = class, struct, interface, enum, method, property, event

dotnet_naming_style.pascal_case.capitalization = pascal_case
