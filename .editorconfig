# エディタ間でインデント・文字コード・改行を統一する
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Markdown は行末スペース 2 個が改行の意味を持つため削除しない
trim_trailing_whitespace = false

# PowerShell 5.1 は BOM なしだと日本語を ANSI として誤読するため、BOM 必須・CRLF
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.cs]
indent_size = 4

# Razor ビューは .cs と揃えて BOM なし・インデント4（実測: 構造的な行はすべて4の倍数、タブ0件）
[*.cshtml]
charset = utf-8
indent_size = 4

# 命名規約は docs/csharp-contributing.md を正とする（ここには定義しない）
