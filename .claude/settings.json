{
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Read",
      "Glob",
      "Grep",
      "PowerShell(.\\.claude\\commands\\server\\start.ps1)",
      "PowerShell(.\\.claude\\commands\\server\\stop.ps1)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(gh pr merge:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "& ./.claude/hooks/guard-claude-md.ps1",
            "shell": "powershell"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& ./.claude/hooks/session-check.ps1",
            "shell": "powershell"
          },
          {
            "type": "command",
            "command": "& ./.claude/hooks/inject-factcheck.ps1",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
